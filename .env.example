# 구글 애드센스 퍼블리셔 ID (앞서 발급받은 ca-pub-… 값)
# 로컬: 이 파일을 복사해 `.env.local`로 저장한 뒤 값을 채우세요.
# Vercel: Project Settings → Environment Variables에 동일 이름으로 등록
# → /ads.txt 가 자동 생성됩니다 (app/ads.txt/route.js)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-1234567890123456

# Web3Forms 문의 폼 (https://web3forms.com 에서 Access Key 발급)
# 클라이언트에서 fetch 하므로 반드시 NEXT_PUBLIC_ 사용
# Vercel: Production / Preview에 각각 등록
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
