# 사이트 기준 URL (예: https://idahoeditor.com). 비어 있으면 코드 fallback 사용
NEXT_PUBLIC_SITE_URL=

# GA4 측정 ID (예: G-XXXXXXXX). 비어 있으면 GA 미렌더
NEXT_PUBLIC_GA_ID=

# (선택) Vercel 등에 넣을 수 있으나, 실제 값은 lib/config.js ADSENSE_PUBLISHER_ID 가 사용됩니다.
NEXT_PUBLIC_ADSENSE_ID=ca-pub-1234567890123456

# Web3Forms 문의 폼 (https://web3forms.com 에서 Access Key 발급)
# 브라우저에서 api.web3forms.com 으로 전송하므로 NEXT_PUBLIC_ 접두사 필요
# Vercel: Production / Preview에 등록 후 재배포
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
